{
  "$description": "Ciao Caffè design tokens — menu board system (1920×1080). © 2026 Alican Yıldırım. See LICENSE.",
  "color": {
    "neutral": {
      "cream": "#FFF8F1",
      "ink": "#1A1210",
      "gold": "#E8C07A"
    },
    "theme": {
      "hot":     { "band": "#F54021", "brand": "#F54021", "bg": "#15110F", "line": "#3A2D25", "mute": "#ADA196", "card": "#211A16", "cardLine": "#4A3329" },
      "cold":    { "band": "#1670B5", "brand": "#3DA3EC", "bg": "#101315", "line": "#2C3238", "mute": "#A7ADB2", "card": "#1A1E22", "cardLine": "#333B42" },
      "dessert": { "band": "#7A3E26", "brand": "#F5A35C", "bg": "#15110F", "line": "#3A2D25", "mute": "#ADA196", "card": "#211A16", "cardLine": "#4A3329" }
    }
  },
  "font": {
    "display": "'Kaushan Script', cursive",
    "ui": "'Barlow Condensed', sans-serif",
    "sticker": "'Permanent Marker', cursive"
  },
  "type": {
    "boardTitle":   { "font": "display", "size": "62-76px" },
    "featuredName": { "font": "display", "size": "52-80px" },
    "slogan":       { "font": "sticker", "size": "22-26px", "rotate": "-3deg" },
    "section":      { "font": "ui", "size": "22px", "weight": 800, "tracking": "0.14em", "case": "upper" },
    "columnLabel":  { "font": "ui", "size": "14px", "weight": 700, "tracking": "0.08em", "case": "upper" },
    "itemName":     { "font": "ui", "size": "21-25px", "weight": 600 },
    "itemDesc":     { "font": "ui", "size": "15-18px", "weight": 400, "color": "mute" },
    "price":        { "font": "ui", "size": "21-34px", "weight": 600, "numeric": "tabular-nums" },
    "currency":     { "font": "ui", "size": "0.58em", "weight": 700, "opacity": 0.72 },
    "badge":        { "font": "ui", "size": "18px", "weight": 800, "tracking": "0.16em", "case": "upper" }
  },
  "layout": {
    "canvas": "1920x1080",
    "bandHeight": { "list": "184px", "image": "156px" },
    "imagePanel": "620px",
    "dessertPanel": "560px",
    "gutter": "48-64px",
    "illustration": "400x440"
  },
  "radius": { "pill": "999px", "card": "14px", "panel": "22px", "badge": "6-10px" },
  "motion": {
    "slideIn": "600ms ease-out",
    "sceneFade": "700ms ease-out",
    "pourStory": "5000ms",
    "fill": "3300ms cubic-bezier(.3,.55,.35,1)",
    "pop": "700ms cubic-bezier(.34,1.56,.64,1)",
    "starTwinkle": "3600ms ease-in-out infinite",
    "cardWave": "4000ms ease-in-out infinite",
    "backdropSpin": "80s linear infinite",
    "slideDuration": { "hot": "7.86s", "cold": "7s" },
    "loop": "60s"
  },
  "size": {
    "UNICO":   { "label": "Tek ölçü" },
    "PICCOLO": { "label": "12 oz · 350 ml" },
    "GRANDE":  { "label": "16 oz · 470 ml" }
  }
}
